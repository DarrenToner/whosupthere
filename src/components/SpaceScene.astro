<div class="space-scene" aria-hidden="true">
  <canvas id="orbit-canvas"></canvas>
  <div class="scene-vignette"></div>
  <div class="scene-grain"></div>
</div>

<script>
  import * as THREE from 'three';
  const canvas = document.querySelector('#orbit-canvas');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (canvas instanceof HTMLCanvasElement) {
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(34, 1, 0.1, 100);
    camera.position.set(0, 0.15, 7.2);
    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true, powerPreference: 'high-performance' });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.75));
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    const world = new THREE.Group();
    world.rotation.set(0.12, -0.35, -0.08);
    scene.add(world);
    world.add(new THREE.Mesh(new THREE.SphereGeometry(2.02, 72, 72), new THREE.MeshStandardMaterial({ color: 0x06110d, emissive: 0x020806, roughness: 0.84, metalness: 0.05 })));

    const dotsGeometry = new THREE.BufferGeometry();
    const dotPositions = [];
    const dotCount = 2100;
    for (let i = 0; i < dotCount; i += 1) {
      const y = 1 - (i / (dotCount - 1)) * 2;
      const radius = Math.sqrt(1 - y * y);
      const theta = Math.PI * (3 - Math.sqrt(5)) * i;
      dotPositions.push(Math.cos(theta) * radius * 2.035, y * 2.035, Math.sin(theta) * radius * 2.035);
    }
    dotsGeometry.setAttribute('position', new THREE.Float32BufferAttribute(dotPositions, 3));
    world.add(new THREE.Points(dotsGeometry, new THREE.PointsMaterial({ color: 0xcbff3f, size: 0.018, transparent: true, opacity: 0.68 })));

    const gridMaterial = new THREE.LineBasicMaterial({ color: 0x9aefff, transparent: true, opacity: 0.18 });
    for (let latitude = -60; latitude <= 60; latitude += 30) {
      const points = [];
      const lat = THREE.MathUtils.degToRad(latitude);
      for (let i = 0; i <= 128; i += 1) {
        const longitude = (i / 128) * Math.PI * 2;
        points.push(new THREE.Vector3(Math.cos(longitude) * Math.cos(lat) * 2.05, Math.sin(lat) * 2.05, Math.sin(longitude) * Math.cos(lat) * 2.05));
      }
      world.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(points), gridMaterial));
    }
    for (let longitude = 0; longitude < 180; longitude += 30) {
      const points = [];
      const lon = THREE.MathUtils.degToRad(longitude);
      for (let i = 0; i <= 128; i += 1) {
        const latitude = -Math.PI / 2 + (i / 128) * Math.PI;
        points.push(new THREE.Vector3(Math.cos(lon) * Math.cos(latitude) * 2.05, Math.sin(latitude) * 2.05, Math.sin(lon) * Math.cos(latitude) * 2.05));
      }
      world.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(points), gridMaterial));
    }

    world.add(new THREE.Mesh(new THREE.SphereGeometry(2.13, 64, 64), new THREE.ShaderMaterial({
      transparent: true, side: THREE.BackSide, blending: THREE.AdditiveBlending,
      vertexShader: `varying vec3 n; varying vec3 eye; void main(){ vec4 mv = modelViewMatrix * vec4(position,1.0); n = normalize(normalMatrix * normal); eye = normalize(-mv.xyz); gl_Position = projectionMatrix * mv; }`,
      fragmentShader: `varying vec3 n; varying vec3 eye; void main(){ float f = pow(0.72 - dot(n, eye), 2.1); gl_FragColor = vec4(0.25, 1.0, 0.64, f * 0.7); }`,
    })));

    const orbitGroup = new THREE.Group();
    orbitGroup.rotation.set(1.2, 0.15, -0.4);
    world.add(orbitGroup);
    [2.48, 2.72].forEach((radius, index) => {
      const ring = new THREE.Mesh(new THREE.TorusGeometry(radius, index ? 0.005 : 0.009, 6, 220), new THREE.MeshBasicMaterial({ color: 0xec5cff, transparent: true, opacity: index ? 0.16 : 0.42 }));
      ring.scale.y = index ? 0.76 : 0.9;
      orbitGroup.add(ring);
    });

    const station = new THREE.Group();
    station.add(new THREE.Mesh(new THREE.BoxGeometry(0.17, 0.08, 0.07), new THREE.MeshStandardMaterial({ color: 0xcbff3f, emissive: 0x476414, metalness: 0.75, roughness: 0.25 })));
    const panelMaterial = new THREE.MeshBasicMaterial({ color: 0x85bcff });
    const leftPanel = new THREE.Mesh(new THREE.BoxGeometry(0.28, 0.012, 0.12), panelMaterial);
    const rightPanel = leftPanel.clone();
    leftPanel.position.x = -0.24; rightPanel.position.x = 0.24;
    station.add(leftPanel, rightPanel); station.position.set(2.48, 0, 0); station.rotation.z = 0.35;
    orbitGroup.add(station);

    const starsGeometry = new THREE.BufferGeometry();
    const stars = [];
    for (let i = 0; i < 1100; i += 1) {
      const radius = 12 + Math.random() * 24, theta = Math.random() * Math.PI * 2, phi = Math.acos(2 * Math.random() - 1);
      stars.push(radius * Math.sin(phi) * Math.cos(theta), radius * Math.cos(phi), radius * Math.sin(phi) * Math.sin(theta));
    }
    starsGeometry.setAttribute('position', new THREE.Float32BufferAttribute(stars, 3));
    scene.add(new THREE.Points(starsGeometry, new THREE.PointsMaterial({ color: 0xe7fff0, size: 0.035, transparent: true, opacity: 0.6, sizeAttenuation: true })));
    scene.add(new THREE.AmbientLight(0x8fd6c4, 0.45));
    const keyLight = new THREE.DirectionalLight(0xcbff9d, 4.5); keyLight.position.set(-3, 3, 5); scene.add(keyLight);
    const rimLight = new THREE.PointLight(0xec5cff, 24, 12); rimLight.position.set(3.5, -2, 2); scene.add(rimLight);

    let dragging = false, previous = { x: 0, y: 0 }, pointerTarget = { x: 0, y: 0 };
    canvas.addEventListener('pointerdown', (event) => { dragging = true; previous = { x: event.clientX, y: event.clientY }; canvas.setPointerCapture(event.pointerId); });
    canvas.addEventListener('pointerup', () => { dragging = false; });
    canvas.addEventListener('pointermove', (event) => {
      const bounds = canvas.getBoundingClientRect();
      pointerTarget = { x: (event.clientX / bounds.width - 0.5) * 0.22, y: (event.clientY / bounds.height - 0.5) * 0.16 };
      if (dragging) { world.rotation.y += (event.clientX - previous.x) * 0.006; world.rotation.x += (event.clientY - previous.y) * 0.003; previous = { x: event.clientX, y: event.clientY }; }
    });
    window.addEventListener('crew-focus', (event) => { const index = Number(event.detail?.index || 0); world.rotation.y = -index * 0.55; orbitGroup.rotation.z = -0.4 + index * 0.08; });
    const resize = () => { const bounds = canvas.parentElement?.getBoundingClientRect(); if (!bounds) return; renderer.setSize(bounds.width, bounds.height, false); camera.aspect = bounds.width / bounds.height; camera.updateProjectionMatrix(); };
    new ResizeObserver(resize).observe(canvas.parentElement); resize();
    const render = (time = 0) => { const elapsed = time / 1000; if (!dragging && !reduceMotion) world.rotation.y += 0.0015; if (!reduceMotion) orbitGroup.rotation.z += 0.0032; world.rotation.x += (0.1 + pointerTarget.y - world.rotation.x) * 0.018; world.position.x += (pointerTarget.x - world.position.x) * 0.018; station.rotation.y = elapsed * 0.8; renderer.render(scene, camera); requestAnimationFrame(render); };
    render();
  }
</script>
